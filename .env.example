DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Database -------------------------------------------------------------
# These defaults are the Docker ones. Running WITHOUT Docker — against a
# PostgreSQL you installed yourself — change three of them:
#
#   POSTGRES_USER=postgres
#   POSTGRES_PASSWORD=<the password you set during the PostgreSQL install>
#   POSTGRES_HOST=127.0.0.1
#
# POSTGRES_HOST is the one that catches people out: `db` is the name of the
# Docker container and means nothing outside Docker.
POSTGRES_DB=discern
POSTGRES_USER=discern
POSTGRES_PASSWORD=discern
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (optional) -----------------------------------------------------
# Only the background outbox drain uses this. No web request queues a job, so
# without Docker you can leave Redis uninstalled and run the drain by hand:
#   python manage.py drain_outbox
REDIS_URL=redis://redis:6379/0
OUTBOX_MAX_ATTEMPTS=5

# --- Business policy ------------------------------------------------------
# APPROVAL_THRESHOLD=500000
# RFQ_MINIMUM_VENDORS=3
# RFQ_MINIMUM_VENDORS_BELOW_VALUE=0
